#!/usr/bin/env bash
#
# pi-cell — run the whole pi agent inside a bubblewrap sandbox.
#
#   sudo pi-cell setup [--install]  one-time: deps check, sandbox user, state dir,
#                                   config + secrets placeholders, nftables egress
#                                   ruleset, repo ACLs
#   sudo pi-cell run [--dry-run] [--cell NAME] [-- args...]
#                                   launch pi in the sandbox (TUI, or `-p` for scripts)
#   sudo pi-cell grant-auth       (re-)grant ACLs so host auth.json is live in the sandbox
#   sudo pi-cell chown              hand repo files back to the real user
#   sudo pi-cell teardown [--purge] remove the nftables ruleset (and user/config)
#   pi-cell check                   non-root prerequisite check
#
# Trust boundary:
#   pi can modify ONLY {repo -> /workspace, state -> /state}
#   pi can reach  ONLY {DNS, TLS:443, configured DB/ports}
#   everything else is not visible, not writable, not reachable.
#
# Mechanism: one long-lived sandbox (namespaces, no daemon) whose writable host
# paths are exactly the two above. Network is shared but the nftables ruleset
# restricts only the sandbox uid. Secrets are bind-mounted read-only and sourced
# inside, never passed in argv. Egress is port-based, not destination-based: it
# is NOT an exfiltration control (see README).
set -euo pipefail

readonly CONF="${PICELL_CONF:-/etc/pi-cell/config}"
readonly SECRETS="${PICELL_SECRETS:-/etc/pi-cell/secrets.env}"
readonly NFT="${PICELL_NFT:-/etc/pi-cell/pi-cell.nft}"
readonly SANDBOX_USER=pi-sandbox

die()  { echo "pi-cell: error: $*" >&2; exit 1; }
info() { echo "pi-cell: $*" >&2; }   # stdout belongs to the agent
need_root() { [[ $(id -u) == 0 ]] || die "this command needs root (run with sudo)"; }

# ---------------------------------------------------------------- config
load_config() {
  [[ -r $CONF ]] || die "config not found at $CONF (run: sudo pi-cell setup)"
  # shellcheck disable=SC1090
  source "$CONF"
  : "${REPO:?REPO unset in $CONF}"
  : "${STATE_DIR:?STATE_DIR unset in $CONF}"
  : "${BUN_HOST_DIR:?BUN_HOST_DIR unset in $CONF}"
  [[ -d $REPO ]]        || die "REPO is not a directory: $REPO"
  [[ -d $STATE_DIR ]]   || die "STATE_DIR is not a directory (run: sudo pi-cell setup): $STATE_DIR"
  [[ -d $BUN_HOST_DIR ]] || die "BUN_HOST_DIR is not a directory: $BUN_HOST_DIR"
  # resolve first, then refuse paths the sandbox can turn into a symlink: /state
  # is sandbox-writable, so a bind of "$STATE_DIR/x" could become a bind of /
  REPO=$(realpath -e -- "$REPO")             || die "cannot resolve REPO: $REPO"
  STATE_DIR=$(realpath -e -- "$STATE_DIR")   || die "cannot resolve STATE_DIR: $STATE_DIR"
  BUN_HOST_DIR=$(realpath -e -- "$BUN_HOST_DIR") || die "cannot resolve BUN_HOST_DIR: $BUN_HOST_DIR"
  [[ $STATE_DIR != / ]] || die "STATE_DIR must not be / (setup would chown the world)"
  local v
  for v in REPO BUN_HOST_DIR; do
    [[ ${!v} != "$STATE_DIR"/* ]] \
      || die "$v must not live under STATE_DIR: the sandbox could replace it with a symlink"
  done
  DB_ADDR="${DB_ADDR:-}"
  DB_PORT="${DB_PORT:-5432}"
  REPO_ROOT="${REPO_ROOT:-}"
  if [[ -n $REPO_ROOT ]]; then
    [[ -d $REPO_ROOT ]] || die "REPO_ROOT is not a directory: $REPO_ROOT"
    REPO_ROOT=$(realpath -e -- "$REPO_ROOT") || die "cannot resolve REPO_ROOT: $REPO_ROOT"
    [[ $REPO_ROOT != "$STATE_DIR"/* ]] || die "REPO_ROOT must not live under STATE_DIR"
  fi
  EXTRA_PORTS="${EXTRA_PORTS:-}"
  EXTRA_RO_BINDS="${EXTRA_RO_BINDS:-}"
  PI_ARGS="${PI_ARGS:-}"
  GIT_NAME="${GIT_NAME:-}"
  GIT_EMAIL="${GIT_EMAIL:-}"
  AUTH_MODE="${AUTH_MODE:-ro}"   # ro = sandbox reads host auth.json live; rw = sandbox can also write
  ALLOW_NESTED_USERNS="${ALLOW_NESTED_USERNS:-0}"  # 1 = sandbox may create its own userns (inner bwrap / Claude Code)
  # host pi agent dir = source of truth for auth.json (config can override)
  if [[ -n ${PI_AGENT_DIR:-} ]]; then
    HOST_PI_AGENT=$PI_AGENT_DIR
  elif [[ -n ${SUDO_USER:-} ]]; then
    HOST_PI_AGENT="$(getent passwd "$SUDO_USER" | cut -d: -f6)/.pi/agent"
  else
    HOST_PI_AGENT="$HOME/.pi/agent"
  fi
}

ensure_state_agent() {
  # the sandbox's ~/.pi/agent; the auth.json placeholder is where the host's
  # real auth.json gets bind-mounted (target must exist before the bind)
  local base="${1:-$STATE_DIR}"
  local agent="$base/.pi/agent"
  local target="$agent/auth.json"
  # /state is sandbox-writable: never let root follow a planted symlink out of it
  [[ -L $base || -L $STATE_DIR/cells || -L $agent || -L $target ]] \
    && die "refusing: symlink under $agent (state is sandbox-writable)"
  mkdir -p "$agent"
  chown "$SANDBOX_USER:$SANDBOX_USER" "$base" "$base/.pi"
  chown -R "$SANDBOX_USER:$SANDBOX_USER" "$agent"
  [[ -e $target ]] || install -m 0600 -o "$SANDBOX_USER" -g "$SANDBOX_USER" /dev/null "$target"
}

grant_auth_access() {
  # Make the HOST's real auth.json bind-mountable + readable by the sandbox
  # user — no copying. ~/.pi/agent is 0700 and auth.json is 0600 owned by the
  # real user, so the sandbox user needs ACLs: x on the dir (traverse) and
  # r/rw on the file. Re-granted on every run because pi rewrites auth.json
  # with chmod(0600), which clobbers the ACL mask between sessions.
  [[ -d $HOST_PI_AGENT ]] || {
    info "no host agent dir at $HOST_PI_AGENT — sandbox auth will be local-only"
    return 0
  }
  setfacl -m "u:$SANDBOX_USER:x" "$HOST_PI_AGENT" 2>/dev/null \
    || info "could not set ACL on $HOST_PI_AGENT (run setup with sudo)"
  if [[ -f $HOST_PI_AGENT/auth.json ]]; then
    local perm=r
    [[ $AUTH_MODE == rw ]] && perm=rw
    setfacl -m "u:$SANDBOX_USER:$perm" "$HOST_PI_AGENT/auth.json"
    info "live-bind auth.json: granted ACL u:$SANDBOX_USER:$perm on $HOST_PI_AGENT/auth.json"
  else
    info "no host auth.json at $HOST_PI_AGENT/auth.json — pi can /login inside the sandbox (local-only)"
  fi
}

# --------------------------------------------------------------- secrets
grant_secrets_access() {
  # secrets.env is root-only; ACL just that file so the sandbox can read its
  # bind-mounted copy. Nothing secret is passed in argv (world-readable
  # /proc/*/cmdline) — the wrapper sources /run/secrets.env inside instead.
  [[ -f $SECRETS ]] || return 0
  setfacl -m "u:$SANDBOX_USER:r" "$SECRETS" 2>/dev/null \
    || info "could not ACL $SECRETS (needs root)"
}

# ------------------------------------------------------------------ run
cmd_run() {
  [[ ${DRY_RUN:-0} == 1 ]] || need_root
  load_config

  # --repo names a directory under REPO_ROOT (root-configured): one repo per job,
  # so the caller can only pick a name, never a path.
  if [[ -n ${JOB_REPO:-} ]]; then
    [[ -n $REPO_ROOT ]] || die "--repo needs REPO_ROOT in $CONF"
    [[ $JOB_REPO =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "invalid repo name: $JOB_REPO"
    [[ -d $REPO_ROOT/$JOB_REPO ]] || die "no such repo under REPO_ROOT: $JOB_REPO"
    REPO=$(realpath -e -- "$REPO_ROOT/$JOB_REPO") || die "cannot resolve repo: $JOB_REPO"
    [[ $REPO == "$REPO_ROOT"/* ]] || die "--repo escapes REPO_ROOT: $JOB_REPO"
  fi

  if [[ -n ${PROMPT_FILE:-} ]]; then
    local pf
    pf=$(realpath -e -- "$PROMPT_FILE" 2>/dev/null) || die "no such --prompt-file: $PROMPT_FILE"
    PROMPT_FILE=$pf
  fi

  # one HOME per cell, so concurrent cells do not share pi sessions, auth.json
  # or bun's cache. No --cell = one long-lived cell in /state (as before).
  local cell_home=/state
  local cell_dir="$STATE_DIR"
  if [[ -n ${CELL:-} ]]; then
    [[ $CELL =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "invalid cell name: $CELL"
    cell_home="/state/cells/$CELL"
    cell_dir="$STATE_DIR/cells/$CELL"
  fi

  if [[ ${DRY_RUN:-0} != 1 ]]; then
    # fail closed: no egress policy, no sandbox
    nft list table inet pi-cell >/dev/null 2>&1 || nft -f "$NFT" 2>/dev/null || true
    nft list table inet pi-cell >/dev/null 2>&1 \
      || die "egress ruleset not loaded (run: sudo pi-cell setup)"
    ensure_state_agent "$cell_dir"
    grant_auth_access   # ACLs so the real host auth.json can be bind-mounted (no copy)
    grant_secrets_access
    # stage the prompt into the cell dir so the sandbox can read it whatever the
    # original's ownership is (and so it cannot change under us mid-run)
    [[ -n ${PROMPT_FILE:-} ]] && install -m 0644 -- "$PROMPT_FILE" "$cell_dir/prompt.txt"
  fi

  local bwrap=(bwrap --die-with-parent
    --unshare-user --unshare-pid --unshare-ipc --unshare-uts --share-net
    --ro-bind /usr /usr
    --ro-bind /etc /etc
    --ro-bind /sys /sys
    --ro-bind "$BUN_HOST_DIR" /bun
    --bind "$REPO" /workspace
    --bind "$STATE_DIR" /state
    --tmpfs /tmp
    --tmpfs /run
    --proc /proc
    --dev /dev
    --size 536870912 --tmpfs /dev/shm
    --clearenv
    --setenv PATH /bun/bin:/usr/local/bin:/usr/bin:/bin
    --setenv HOME "$cell_home"
    --setenv TERM "${TERM:-xterm-256color}"
    --setenv LANG "${LANG:-C.UTF-8}"
    --setenv BUN_INSTALL /bun
    --setenv BUN_INSTALL_CACHE_DIR "$cell_home/bun-cache")

  # only /usr is bound, so the usrmerge dirs have to be mounted explicitly:
  # /bin/sh is what the umask wrapper execs, /lib* is what it links against.
  local d
  for d in usr/local opt bin sbin lib lib64; do
    [[ -e /$d ]] && bwrap+=(--ro-bind "/$d" "/$d")
  done
  # resolv.conf is usually a symlink into /run, which is a tmpfs here: bind the
  # real file at its real path so the symlink resolves inside the sandbox.
  local resolv
  resolv=$(readlink -f /etc/resolv.conf 2>/dev/null || true)
  [[ -n $resolv && $resolv != /etc/resolv.conf ]] && bwrap+=(--ro-bind "$resolv" "$resolv")
  # extra read-only inputs, mounted at their identical host paths: a project's
  # shared symlinks (docs/, .venv, assets/) point at host paths, which the
  # /workspace layout does not provide.
  local b p
  for b in ${EXTRA_RO_BINDS:-}; do
    p=$(realpath -e -- "$b" 2>/dev/null) || die "EXTRA_RO_BINDS path missing: $b"
    b=$p
    case $b in
      /|/workspace|/state|/bun|/proc|/dev|/sys|/etc|/usr|/tmp|/run|/bin|/sbin|/lib|/lib64)
        die "EXTRA_RO_BINDS must not shadow a sandbox path: $b" ;;
    esac
    [[ $b != "$STATE_DIR"/* ]] || die "EXTRA_RO_BINDS must not live under STATE_DIR"
    bwrap+=(--ro-bind "$b" "$b")
  done
  [[ $ALLOW_NESTED_USERNS == 1 ]] || bwrap+=(--disable-userns)

  # live bind-mount of the host's real auth.json (no copy):
  if [[ -f $HOST_PI_AGENT/auth.json ]]; then
    if [[ $AUTH_MODE == rw ]]; then
      bwrap+=(--bind "$HOST_PI_AGENT/auth.json" "$cell_home/.pi/agent/auth.json")
    else
      bwrap+=(--ro-bind "$HOST_PI_AGENT/auth.json" "$cell_home/.pi/agent/auth.json")
    fi
  fi

  # secrets live in a root-only file, bound read-only and sourced by the wrapper
  [[ -f $SECRETS ]] && bwrap+=(--ro-bind "$SECRETS" /run/secrets.env)
  # the prompt is a file, never argv: a user's paper text must not show up in the
  # host's /proc/*/cmdline, and a prompt starting with "-" must not parse as a flag
  [[ -n ${PROMPT_FILE:-} ]] && bwrap+=(--ro-bind "$cell_dir/prompt.txt" /run/prompt.txt)

  [[ -z $GIT_NAME  ]] || bwrap+=(--setenv GIT_AUTHOR_NAME "$GIT_NAME" --setenv GIT_COMMITTER_NAME "$GIT_NAME")
  [[ -z $GIT_EMAIL ]] || bwrap+=(--setenv GIT_AUTHOR_EMAIL "$GIT_EMAIL" --setenv GIT_COMMITTER_EMAIL "$GIT_EMAIL")

  bwrap+=(--chdir /workspace)

  local pi_args=()
  read -r -a pi_args <<< "$PI_ARGS"   # split config PI_ARGS on whitespace

  info "launching pi in sandbox (workspace=$REPO home=$cell_home egress=DNS+443+db:${DB_PORT})"
  # umask 002 + ACLs so files created by the sandbox stay editable by you.
  # --timeout kills the whole process group, so a hung render cannot hold the queue
  local tmo=()
  if [[ -n ${TIMEOUT:-} ]]; then
    [[ $TIMEOUT =~ ^[0-9]+$ ]] || die "--timeout wants seconds, got: $TIMEOUT"
    tmo=(timeout --kill-after=30 "$TIMEOUT")
  fi
  # shellcheck disable=SC2016  # $@ and $(cat) expand in the sandbox's sh, not here
  local cmd=("${tmo[@]}" sudo -u "$SANDBOX_USER" "${bwrap[@]}" -- \
    /bin/sh -c 'umask 002; [ -r /run/secrets.env ] && { set -a; . /run/secrets.env; set +a; }; [ -s /run/prompt.txt ] && set -- "$@" -p "$(cat /run/prompt.txt)"; exec "$@"' \
      pi /bun/bin/pi "${pi_args[@]}" "$@")
  if [[ ${DRY_RUN:-0} == 1 ]]; then
    printf '%q ' "${cmd[@]}"; echo; exit 0
  fi
  exec "${cmd[@]}"
}

# ----------------------------------------------------------------- setup
cmd_setup() {
  need_root

  # 1. dependencies
  local deps=(bubblewrap nftables acl) missing=()
  for d in "${deps[@]}"; do
    command -v "$d" >/dev/null 2>&1 || missing+=("$d")
  done
  if ((${#missing[@]})); then
    if [[ ${INSTALL_DEPS:-0} == 1 ]]; then
      info "installing: ${missing[*]}"
      apt-get update -y >/dev/null
      apt-get install -y "${missing[@]}" >/dev/null
    else
      die "missing packages: ${missing[*]} — rerun 'sudo pi-cell setup --install' or run: sudo apt-get install -y ${missing[*]}"
    fi
  fi

  # 2. sandbox user
  getent passwd "$SANDBOX_USER" >/dev/null || {
    info "creating system user $SANDBOX_USER"
    useradd --system --shell /usr/sbin/nologin --no-create-home "$SANDBOX_USER"
  }
  local uid; uid=$(id -u "$SANDBOX_USER")

  # 3. directories
  install -d -m 0755 /etc/pi-cell /var/lib/pi-cell

  # read config if present (paths only, never secrets)
  if [[ -r $CONF ]]; then
    # shellcheck disable=SC1090
    source "$CONF"
    STATE_DIR="${STATE_DIR:-/var/lib/pi-cell/state}"
    REPO="${REPO:-}"
  else
    STATE_DIR=/var/lib/pi-cell/state
    REPO=""
  fi
  [[ -d $STATE_DIR ]] || install -d -m 0700 -o "$SANDBOX_USER" -g "$SANDBOX_USER" "$STATE_DIR"
  [[ $(realpath -e -- "$STATE_DIR") != / ]] || die "STATE_DIR must not be /"

  # host pi agent dir (used for auth.json source of truth)
  if [[ -n ${PI_AGENT_DIR:-} ]]; then
    HOST_PI_AGENT=$PI_AGENT_DIR
  elif [[ -n ${SUDO_USER:-} ]]; then
    HOST_PI_AGENT="$(getent passwd "$SUDO_USER" | cut -d: -f6)/.pi/agent"
  else
    HOST_PI_AGENT="$HOME/.pi/agent"
  fi

  # sandbox's ~/.pi/agent: seeded from the host's auth.json, then sandbox-owned
  ensure_state_agent
  grant_auth_access
  grant_secrets_access

  # 4. config + secrets placeholders
  if [[ ! -e $CONF ]]; then
    cat > "$CONF" <<'CFG'
# pi-cell configuration — paths only, NO secrets (put those in secrets.env)
REPO=/home/eduardoneville/work/my-repo
# Optional: per-job repos. `run --repo NAME` binds $REPO_ROOT/NAME as /workspace,
# so one install serves many projects (NAME is a single directory component).
REPO_ROOT=
STATE_DIR=/var/lib/pi-cell/state
BUN_HOST_DIR=/home/eduardoneville/.bun
# Optional: host ~/.pi/agent dir (auth.json source of truth). Default: invoking user's.
PI_AGENT_DIR=
# auth.json mount: ro (default, sandbox reads host file live) | rw (sandbox can also write)
AUTH_MODE=ro
# 1 = let the sandbox create its own user namespaces (needed for an inner bwrap,
# e.g. Claude Code's Linux sandbox). 0 = block nested userns (smaller kernel surface).
ALLOW_NESTED_USERNS=0
# Egress beyond DNS + TLS:443 (all optional):
DB_ADDR=            # leave empty for "any host", or e.g. 10.0.0.5
DB_PORT=5432
EXTRA_PORTS=        # comma list, e.g. 3000,8080 (all destinations)
# Optional: extra read-only paths mounted at their identical host paths (space
# separated, no spaces in the paths). For projects whose symlinks point into a
# shared workspace (docs/, .venv, assets/).
EXTRA_RO_BINDS=
# Optional git identity injected as env vars (so agent commits are attributed):
GIT_NAME=
GIT_EMAIL=
# Optional extra args passed to pi, e.g. PI_ARGS="--provider anthropic"
PI_ARGS=
CFG
    chmod 0644 "$CONF"
    info "wrote $CONF (edit REPO at minimum)"
  fi

  if [[ ! -e $SECRETS ]]; then
    cat > "$SECRETS" <<'SEC'
# pi-cell secrets — OPTIONAL. Credentials normally come from the live bind of
# the host's auth.json. Add KEY=VALUE lines here only for providers you
# configure via environment variables on the host and want inside the sandbox.
# This file is shell syntax (it is sourced inside the sandbox): quote values
# that contain spaces, '#' or '$'. It is bind-mounted read-only at
# /run/secrets.env, never passed in argv.
# Example: OPENAI_API_KEY=sk-...
SEC
    chmod 0600 "$SECRETS"
    info "wrote optional $SECRETS (only needed for env-configured providers)"
  fi

  # 5. state volume ownership (bun's cache is set via BUN_INSTALL_CACHE_DIR at
  #    run time — the host ~/.bun is read-only, so the default cache would fail)
  chown -R "$SANDBOX_USER:$SANDBOX_USER" "$STATE_DIR"

  # 6. nftables ruleset (egress + inbound, restricted to the sandbox uid)
  local db_rule=""
  if [[ -n $DB_ADDR ]]; then
    db_rule="    meta skuid $uid ip daddr $DB_ADDR tcp dport ${DB_PORT:-5432} accept"
  else
    db_rule="    meta skuid $uid tcp dport ${DB_PORT:-5432} accept"
  fi
  local extra_rules=""
  local p
  for p in ${EXTRA_PORTS//,/ }; do
    [[ -n $p ]] && extra_rules+="    meta skuid $uid tcp dport $p accept"$'\n'
  done
  info "writing nftables ruleset ($NFT)"
  cat > "$NFT" <<EOF
table inet pi-cell {
  chain output {
    type filter hook output priority 0; policy accept;
    meta skuid $uid ct state established,related ct direction original accept
    meta skuid $uid ct state established ct direction reply oif "lo" accept
    meta skuid $uid udp dport 53 accept
    meta skuid $uid tcp dport 53 accept
    meta skuid $uid tcp dport 443 accept
$db_rule
${extra_rules}    meta skuid $uid drop
  }
  # Inbound cannot be filtered per-uid on a shared netns (and policy drop here
  # would firewall the whole host), so the reverse channel is closed in output
  # above: replies are only allowed on flows this uid started, or on loopback.
  chain input {
    type filter hook input priority 0; policy accept;
    ct state established,related accept
    iif "lo" accept
  }
}
EOF
  nft delete table inet pi-cell 2>/dev/null || true
  nft -f "$NFT"
  info "nftables ruleset loaded: only uid $uid ($SANDBOX_USER) is restricted"

  # 7. repo ACLs — sandbox can read/write the repo, and stays able to edit
  #    files you created; new files inherit ACLs for both of you (via umask 002)
  if [[ -n $REPO && -d $REPO ]] || [[ -n ${REPO_ROOT:-} && -d ${REPO_ROOT:-} ]]; then
    local realuser="${SUDO_USER:-root}"
    local acl_dirs=()
    local d
    [[ -n $REPO && -d $REPO ]] && acl_dirs+=("$REPO")
    # per-job repos are created later by the caller, so the parent needs the
    # default ACLs to hand down to them
    [[ -n ${REPO_ROOT:-} && -d ${REPO_ROOT:-} ]] && acl_dirs+=("$REPO_ROOT")
    info "granting rwx ACLs on ${acl_dirs[*]} for $SANDBOX_USER and $realuser"
    for d in "${acl_dirs[@]}"; do
      setfacl -R -m u:"$SANDBOX_USER":rwx -m d:u:"$SANDBOX_USER":rwx -- "$d"
      [[ $realuser == root ]] || setfacl -R -m u:"$realuser":rwx -m d:u:"$realuser":rwx -- "$d"
    done
  else
    info "REPO not set/valid yet — set REPO in $CONF and re-run setup for ACLs"
  fi

  info "done. Next:"
  info "  1. edit $CONF          (set REPO; optional DB_ADDR/DB_PORT/EXTRA_PORTS)"
  info "  2. re-run setup once so ACLs pick up the repo:   sudo pi-cell setup"
  info "  3. launch:                                       sudo pi-cell run"
  info "  (credentials: host auth.json is bind-mounted live into the sandbox — no copy)"
  info "  (if you ever edit auth.json by hand, re-run setup or: sudo pi-cell grant-auth)"
}

# --------------------------------------------------------------- teardown
revoke_grants() {
  # ACLs are re-granted on every run/setup, so drop them when we stop using
  # them: they are numeric, and a later account reusing this uid would
  # otherwise inherit read on auth.json/secrets and rwx on the repo.
  local p
  for p in "$HOST_PI_AGENT" "$HOST_PI_AGENT/auth.json" "$SECRETS"; do
    [[ -e $p ]] || continue
    setfacl -x "u:$SANDBOX_USER" "$p" 2>/dev/null || true
  done
  if [[ -d ${REPO:-} ]]; then
    setfacl -R -x "u:$SANDBOX_USER" -- "$REPO" 2>/dev/null || true
    setfacl -R -x "d:u:$SANDBOX_USER" -- "$REPO" 2>/dev/null || true
  fi
  return 0
}

cmd_teardown() {
  need_root
  # revoke before (possibly) removing the user, while the name still resolves
  ( load_config && revoke_grants ) 2>/dev/null || info "ACLs not revoked (config/paths unavailable)"
  if nft delete table inet pi-cell 2>/dev/null; then
    info "nftables ruleset removed"
  else
    info "no ruleset to remove"
  fi
  if [[ ${PURGE:-0} == 1 ]]; then
    userdel "$SANDBOX_USER" 2>/dev/null && info "user $SANDBOX_USER removed"
    rm -rf /etc/pi-cell && info "removed /etc/pi-cell"
    info "state dir left in place (delete manually if wanted)"
  else
    info "state/config left in place (use --purge to remove user and config)"
  fi
}

cmd_grant_auth() {
  need_root
  load_config
  grant_auth_access
}

# ------------------------------------------------------------------ chown
cmd_chown() {
  need_root
  load_config
  local realuser="${SUDO_USER:-root}"
  info "handing $REPO back to $realuser (state volume stays sandbox-owned; delete $STATE_DIR to reset it)"
  chown -R "$realuser:$realuser" "$REPO"
}

# ------------------------------------------------------------------ check
cmd_check() {
  local ok=1
  for b in bwrap nft setfacl; do
    if command -v "$b" >/dev/null 2>&1; then echo "$b: OK"; else echo "$b: MISSING (sudo apt install bubblewrap nftables acl)"; ok=0; fi
  done
  if unshare -Ur true 2>/dev/null; then echo "user namespaces: OK"; else echo "user namespaces: BLOCKED"; ok=0; fi
  if getent passwd "$SANDBOX_USER" >/dev/null 2>&1; then echo "user $SANDBOX_USER: OK"; else echo "user $SANDBOX_USER: missing (run setup)"; ok=0; fi
  # does bwrap accept our argv and can it exec a shell with our mount set?
  if command -v bwrap >/dev/null 2>&1; then
    local t=(bwrap --die-with-parent --unshare-user --ro-bind /usr /usr
             --proc /proc --dev /dev --size 1048576 --tmpfs /dev/shm)
    local d
    for d in bin lib lib64; do [[ -e /$d ]] && t+=(--ro-bind "/$d" "/$d"); done
    if "${t[@]}" -- /bin/sh -c true 2>/dev/null; then echo "bwrap smoke test: OK"
    else echo "bwrap smoke test: FAILED (argv/mounts broken)"; ok=0; fi
    if bwrap --help 2>&1 | grep -q -- --disable-userns; then echo "bwrap --disable-userns: OK"
    else echo "bwrap --disable-userns: unsupported (bwrap >= 0.8 needed, or set ALLOW_NESTED_USERNS=1)"; ok=0; fi
  fi
  if [[ -r $CONF ]]; then echo "config: OK ($CONF)"; else echo "config: missing (run setup)"; ok=0; fi
  if [[ -r $SECRETS ]]; then echo "secrets: OK ($SECRETS)"; else echo "secrets: missing (run setup)"; ok=0; fi
  if command -v nft >/dev/null 2>&1 && nft list table inet pi-cell >/dev/null 2>&1; then
    echo "nftables ruleset: loaded"
  else
    echo "nftables ruleset: not loaded (run setup as root)"
  fi
  [[ $ok == 1 ]] && echo "all checks passed — run: sudo pi-cell run" || echo "resolve the issues above, then re-run check"
}

# ------------------------------------------------------------------ main
case "${1:-help}" in
  setup)    shift; [[ ${1:-} == --install ]] && INSTALL_DEPS=1; cmd_setup ;;
  run)
    shift
    while [[ $# -gt 0 ]]; do
      case $1 in
        --dry-run) DRY_RUN=1; shift ;;
        --cell)    CELL="${2:-}"; [[ -n $CELL ]] || die "--cell needs a name"; shift 2 ;;
        --repo)    JOB_REPO="${2:-}"; [[ -n $JOB_REPO ]] || die "--repo needs a name"; shift 2 ;;
        --prompt-file) PROMPT_FILE="${2:-}"; [[ -n $PROMPT_FILE ]] || die "--prompt-file needs a path"; shift 2 ;;
        --timeout) TIMEOUT="${2:-}"; [[ -n $TIMEOUT ]] || die "--timeout needs seconds"; shift 2 ;;
        --)        shift; break ;;
        *)         break ;;
      esac
    done
    cmd_run "$@" ;;
  grant-auth) cmd_grant_auth ;;
  teardown) shift; [[ ${1:-} == --purge ]] && PURGE=1; cmd_teardown ;;
  chown)    cmd_chown ;;
  check)    cmd_check ;;
  help|-h|--help)
    sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) die "unknown command: $1 (try: setup | run | teardown | chown | check | help)" ;;
esac
